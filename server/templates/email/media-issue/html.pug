include ../_partials/camcore.pug

+camcoreEmail('CAMCORE MEDIA • REQUESTS', event, heading)
  if recipientName && recipientName !== recipientEmail && recipientName !== applicationTitle && !/^cameron-media(?:$|\s)/i.test(recipientName.trim())
    p(style='margin: 18px 0 0; color: #435562; font-size: 15px; line-height: 24px;')
      | Hi #{recipientName.replace(/\.|@/g, ((x) => x + '\ufeff'))},
  p(style='margin: 14px 0 0; color: #435562; font-size: 15px; line-height: 24px;')
    | #{body}

  if issueComment
    +camcorePanel('Latest comment')
      div(style='color: #243843; font-size: 14px; line-height: 22px; white-space: pre-wrap;')
        | #{issueComment}
  else if issueDescription
    +camcorePanel('Issue details')
      div(style='color: #243843; font-size: 14px; line-height: 22px; white-space: pre-wrap;')
        | #{issueDescription}

  +camcorePanel('Media')
    table(role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%')
      tr
        td(style='vertical-align: top; padding-right: 16px;')
          div(style='color: #071827; font-size: 21px; line-height: 27px; font-weight: 800;')
            | #{mediaName}
          if extra && extra.length
            div(style='margin-top: 10px; color: #526572; font-size: 13px; line-height: 20px;')
              each item in extra
                span(style='display: block; margin-top: 3px;')
                  strong(style='color: #718391; font-weight: 750;') #{item.name}&nbsp;
                  | #{item.value}
          div(style='margin-top: 8px; color: #81919b; font-size: 12px; line-height: 18px;')
            | #{timestamp}
        if imageUrl
          td.camcore-poster(width='104' style='width: 104px; vertical-align: top;')
            if actionUrl
              a(href=actionUrl style='display: block; text-decoration: none;')
                img(src=imageUrl alt='' width='104' style='display: block; width: 104px; max-width: 104px; height: auto; border-radius: 7px;')
            else
              img(src=imageUrl alt='' width='104' style='display: block; width: 104px; max-width: 104px; height: auto; border-radius: 7px;')

  +camcoreButton(actionUrl, 'View issue')

  table(role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='margin: 26px 0 0;')
    tr
      td(style='padding: 15px 17px; background-color: #f8fafb; border-left: 3px solid #12c4de; color: #435562; font-size: 13px; line-height: 20px;')
        div(style='color: #10212b; font-weight: 750;') Need to add more information?
        div(style='margin-top: 3px;') Open the media issue to review the latest status or add another comment.
