include ../_partials/camcore.pug

+camcoreEmail('CAMCORE MEDIA • REQUESTS', 'PASSWORD RESET', 'Reset your Cameron-Media Requests password')
  +camcoreGreeting(recipientName, recipientEmail, applicationTitle)
  p(style='margin: 14px 0 0; color: #435562; font-size: 15px; line-height: 24px;')
    | We received a request to reset the password for your Cameron-Media Requests account.

  +camcoreButton(resetPasswordLink, 'Reset password')

  +camcorePanel('Reset link')
    div(style='color: #243843; font-size: 14px; line-height: 22px; font-weight: 700;') This secure password reset link is valid for 24 hours.
    div(style='margin-top: 6px; color: #526572; font-size: 13px; line-height: 20px;') After that, you’ll need to request a new one from Cameron-Media Requests.

  table(role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='margin: 26px 0 0;')
    tr
      td(style='padding: 15px 17px; background-color: #f8fafb; border-left: 3px solid #12c4de; color: #435562; font-size: 13px; line-height: 20px;')
        div(style='color: #10212b; font-weight: 750;') Didn’t request this?
        div(style='margin-top: 3px;') No action is required. Your current password will remain unchanged. If you’re concerned about your account, contact CamCore Support.
        div(style='margin-top: 7px;')
          a(href='https://camcore.au/support.html' style='color: #0d879b; font-weight: 700; text-decoration: none;') Open CamCore Support
